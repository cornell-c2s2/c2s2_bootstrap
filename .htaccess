<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Already pointing into frontend/build, leave it alone
  RewriteCond %{REQUEST_URI} ^/frontend/build/ [NC]
  RewriteRule ^ - [L]

  # If the file/dir exists inside frontend/build, serve it
  RewriteCond %{DOCUMENT_ROOT}/frontend/build%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/frontend/build%{REQUEST_URI} -d
  RewriteRule ^(.*)$ frontend/build/$1 [L]

  # Everything else (client-side routes) → index.html
  RewriteRule ^ frontend/build/index.html [L]
</IfModule>
